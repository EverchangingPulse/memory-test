                fingerDown = false;
                button.setPressed(false);
                setHoldButtonState(false, true, false);
                stopNativeVoiceAnswer(true);
                button.performClick();
                return true;
            case MotionEvent.ACTION_CANCEL:
                button.getParent().requestDisallowInterceptTouchEvent(false);
                fingerDown = false;
                button.setPressed(false);
                setHoldButtonState(false, false, false);
                stopNativeVoiceAnswer(false);
                return true;
            default:
                return true;
        }
    }

    private void setupSpeechRecognizer() {
        if (!SpeechRecognizer.isRecognitionAvailable(this)) {
            if (holdToSpeak != null) {
                holdToSpeak.setEnabled(false);
                holdToSpeak.setText("Voice recognition unavailable");
            }
            return;
        }

        try {
            if (android.os.Build.VERSION.SDK_INT >= 31 && SpeechRecognizer.isOnDeviceRecognitionAvailable(this)) {
                speechRecognizer = SpeechRecognizer.createOnDeviceSpeechRecognizer(this);
            } else {
                speechRecognizer = SpeechRecognizer.createSpeechRecognizer(this);
            }
        } catch (Exception ex) {
            speechRecognizer = SpeechRecognizer.createSpeechRecognizer(this);
        }

        speechRecognizer.setRecognitionListener(new RecognitionListener() {
            @Override public void onReadyForSpeech(Bundle params) {
                recognizerStarting = false;
                listening = true;
                status.setText("Recording… keep your finger down while speaking.");
            }
            @Override public void onBeginningOfSpeech() {
                status.setText("Recording your answer…");
            }
            @Override public void onRmsChanged(float rmsdB) {}
            @Override public void onBufferReceived(byte[] buffer) {}
            @Override public void onEndOfSpeech() {
                listening = false;
                if (submitAfterListening) {
                    status.setText("Processing your answer…");
                }
            }
            @Override public void onError(int error) {
                listening = false;
                recognizerStarting = false;
                if (submitAfterListening && !resultsDelivered) {
                    finishVoiceSubmit();
                    return;
                }
                if (fingerDown) {
                    status.setText("Listening… keep holding and speak clearly.");
                } else {
                    status.setText("Voice recognition stopped. Try again.");
                    setHoldButtonState(false, false, false);
                }
            }
            @Override public void onResults(Bundle bundle) {
                listening = false;
                recognizerStarting = false;
                resultsDelivered = true;
                ArrayList<String> matches = bundle.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION);
                if (matches != null && !matches.isEmpty()) {
                    pendingTranscript = matches.get(0);
                    response.setText(normalizeSpokenAnswer(pendingTranscript));
                }
                if (submitAfterListening) {
                    finishVoiceSubmit();
                }
            }
            @Override public void onPartialResults(Bundle bundle) {
                ArrayList<String> partial = bundle.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION);
                if (partial != null && !partial.isEmpty()) {
                    pendingTranscript = partial.get(0);
                    response.setText(normalizeSpokenAnswer(pendingTranscript));
                }
            }
            @Override public void onEvent(int eventType, Bundle params) {}
        });
    }

    private void startNativeVoiceAnswer() {
        if (!setRunning || presenting || correct.isEmpty()) return;
        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
            requestPermissions(new String[]{Manifest.permission.RECORD_AUDIO}, MIC_PERMISSION);
            fingerDown = false;
            setHoldButtonState(false, false, false);
            return;
        }
        if (speechRecognizer == null) {
            setupSpeechRecognizer();
            if (speechRecognizer == null) return;
        }

        pendingTranscript = "";
        response.setText("");
        recognizerIntent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
        recognizerIntent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
        recognizerIntent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, selectedLanguage(answerLanguage));
        recognizerIntent.putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true);
        recognizerIntent.putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 5);
        recognizerIntent.putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, true);
        recognizerIntent.putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 1500L);
        recognizerIntent.putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_POSSIBLY_COMPLETE_SILENCE_LENGTH_MILLIS, 1200L);
        recognizerIntent.putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_MINIMUM_LENGTH_MILLIS, 800L);

        submitAfterListening = false;
        resultsDelivered = false;
        recognizerStarting = true;
        try {
            speechRecognizer.cancel();
        } catch (Exception ignored) {}
        try {
            speechRecognizer.startListening(recognizerIntent);
            status.setText("Starting microphone… keep your finger down.");
        } catch (Exception ex) {
            recognizerStarting = false;
            status.setText("Could not start voice recognition: " + ex.getMessage());
            setHoldButtonState(false, false, false);
        }
    }

    private void stopNativeVoiceAnswer(boolean submitWhenReady) {
        if (speechRecognizer == null) {
            setHoldButtonState(false, false, false);
            return;
        }

        submitAfterListening = submitWhenReady;

        try {
            if (submitWhenReady) {
                long heldMs = System.currentTimeMillis() - pressStartedAt;
                long extraDelay = heldMs < 250 ? (250 - heldMs) : 0;
                handler.postDelayed(() -> {
                    try {
                        if (speechRecognizer != null) speechRecognizer.stopListening();
                    } catch (Exception ignored) {}
                    handler.postDelayed(() -> {
                        if (!fingerDown && submitAfterListening && !resultsDelivered) {
                            finishVoiceSubmit();
                        }
                    }, 1100);
                }, extraDelay);
            } else {
                submitAfterListening = false;
                speechRecognizer.cancel();
                setHoldButtonState(false, false, false);
            }
        } catch (Exception ignored) {
            if (submitWhenReady) finishVoiceSubmit();
        }
    }

    private void finishVoiceSubmit() {
        submitAfterListening = false;
        setHoldButtonState(false, false, false);
        String value = response.getText().toString().trim();
        if (value.isEmpty()) {
            status.setText("No speech recognized. Hold and try again.");
            return;
        }
        if (setRunning && !correct.isEmpty()) {
            status.setText("Voice answer received.");
            submitAnswer(false);
        }
    }

    private void setHoldButtonState(boolean holding, boolean processing, boolean disabled) {
        if (holdToSpeak == null) return;
        if (disabled) {
            holdToSpeak.setEnabled(false);
            holdToSpeak.setText("Voice recognition unavailable");
            holdToSpeak.setBackground(buildButtonFill(Color.parseColor("#CBD5E1"), Color.parseColor("#CBD5E1")));
            return;
        }

        holdToSpeak.setEnabled(true);
        if (processing) {
            holdToSpeak.setText("⏳ Processing answer…");
            holdToSpeak.setBackground(buildButtonFill(Color.parseColor("#F59E0B"), Color.parseColor("#D97706")));
            holdToSpeak.setTextColor(Color.WHITE);
        } else if (holding) {
            holdToSpeak.setText("🔴 Recording — lift to send");
            holdToSpeak.setBackground(buildButtonFill(Color.parseColor("#EF4444"), Color.parseColor("#DC2626")));
            holdToSpeak.setTextColor(Color.WHITE);
        } else {
            holdToSpeak.setText("🎙  Hold to speak");
            holdToSpeak.setBackground(buildButtonFill(COLOR_SUCCESS, Color.parseColor("#15803D")));
            holdToSpeak.setTextColor(Color.WHITE);
        }
    }

    private String normalizeSpokenAnswer(String transcript) {
        String s = transcript.trim().toLowerCase(Locale.ROOT);
        if (selectedLanguage(answerLanguage).startsWith("it")) {
            s = s.replace("i lunga", " J ")
                    .replace("doppia vu", " W ")
                    .replace("doppia v", " W ")
                    .replace("ypsilon", " Y ")
                    .replace("ipsilon", " Y ")
                    .replace("cappa", " K ")
                    .replace("ics", " X ")
                    .replace("acca", " H ");
        }
        Map<String, String> common = new HashMap<>();
        common.put("zero", "0"); common.put("one", "1"); common.put("two", "2"); common.put("three", "3"); common.put("four", "4");
        common.put("five", "5"); common.put("six", "6"); common.put("seven", "7"); common.put("eight", "8"); common.put("nine", "9"); common.put("ten", "10");
        common.put("uno", "1"); common.put("due", "2"); common.put("tre", "3"); common.put("quattro", "4"); common.put("cinque", "5");
        common.put("sei", "6"); common.put("sette", "7"); common.put("otto", "8"); common.put("nove", "9"); common.put("dieci", "10");
        String[] tokens = s.replaceAll("[,.;:!?]", " ").split("\\s+");
        List<String> out = new ArrayList<>();
        for (String token : tokens) {
            if (token.isEmpty()) continue;
            out.add(common.getOrDefault(token, token).toUpperCase(Locale.ROOT));
        }
        return String.join(separatorValue(), out);
    }

    private void startSet() {
        stopSetInternal();
        results.clear();
        setIndex = 0;
        setTarget = clamp(parseInt(exerciseCount.getText().toString(), 10), 1, 100);
        setStartedAt = System.currentTimeMillis();
        setRunning = true;
        startSet.setEnabled(false);
        stopSet.setVisibility(View.VISIBLE);
        renderSummary();
        updateStats();
        startNextExercise();
    }

    private void startNextExercise() {
        if (!setRunning) return;
        if (setIndex >= setTarget) {
            finishSet();
            return;
        }
        currentMeta = generateExercise();
        sequence = currentMeta.sequence;
        correct = determineCorrect(sequence);
        sequenceIndex = 0;
        presenting = true;
        exerciseStartedAt = System.currentTimeMillis();
        response.setText("");
        responseArea.setVisibility(View.GONE);
        counter.setText("Exercise " + (setIndex + 1) + " of " + setTarget);
        status.setText("Starting…");
        handler.postDelayed(this::presentNext, 250);
    }

